{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItineraryContracts",
  "definitions": {
    "ItineraryItem": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "enum": ["attraction", "experience", "meal", "transport", "booking", "note"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "duration_minutes": { "type": "integer" },
        "location": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "locked": { "type": "boolean", "default": false },
        "visited": { "type": "boolean", "default": false },
        "confidence": { "type": "string", "enum": ["HIGH", "MODERATE", "LOW"] },
        "verify_directly_note": { "type": "string" }
      }
    },
    "TripDay": {
      "type": "object",
      "required": ["day_number", "items"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "day_number": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "theme": { "type": "string" },
        "city": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/ItineraryItem" }
        }
      }
    },
    "Itinerary": {
      "type": "object",
      "required": ["trip_id", "days"],
      "properties": {
        "trip_id": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "default": 1 },
        "days": {
          "type": "array",
          "items": { "$ref": "#/definitions/TripDay" }
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": ["id", "name", "category", "classification"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "classification": { "type": "string", "enum": ["tourist", "offbeat"] },
        "reason": { "type": "string" },
        "confidence": { "type": "string", "enum": ["HIGH", "MODERATE", "LOW"] },
        "metadata": { "type": "object" }
      }
    },
    "Booking": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "enum": ["flight", "train", "bus", "hotel", "tour", "ticket", "reservation"] },
        "title": { "type": "string" },
        "provider": { "type": "string" },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "reference_number": { "type": "string" },
        "cost": { "type": "number" },
        "currency": { "type": "string" }
      }
    }
  }
}
